{
  "name": "mte-mediador-monitor-unificado",
  "version": "0.4.1",
  "description": "Mediador Monitor: clientes, sindicatos, contatos, análise PDF e notificações por destinatário",
  "type": "module",
  "private": true,
  "scripts": {
    "local:verificar": "tsx src/local-cli.ts verificar",
    "local:iniciar": "tsx src/local-cli.ts iniciar",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p frontend/tsconfig.json",
    "test": "vitest run",
    "test:postgres-envios": "npm run build && node test/postgres-envios.integration.mjs",
    "test:postgres-recuperacao": "npm run build && node test/postgres-recovery.integration.mjs",
    "postgres:worker": "tsx src/postgres-worker-cli.ts",
    "postgres:preparar-envios": "tsx src/postgres-preparation-cli.ts",
    "postgres:monitorar": "tsx src/postgres-monitoring-worker-cli.ts",
    "postgres:agendar": "tsx src/postgres-monitoring-scheduler-cli.ts",
    "postgres:originais:inventariar": "tsx src/postgres-original-inventory-cli.ts",
    "postgres:validar-monitoramento": "tsx src/postgres-monitoring-check-cli.ts",
    "postgres:validar-importacao": "tsx src/postgres-import-validation-cli.ts",
    "postgres:ensaiar-migracao": "tsx src/postgres-migration-rehearsal-cli.ts",
    "postgres:corte:verificar": "tsx src/postgres-cutover-preflight-cli.ts",
    "postgres:importar-pacote": "tsx src/postgres-operational-import-cli.ts",
    "postgres:validar-operacional": "tsx src/postgres-operational-import-check-cli.ts",
    "sqlite:recuperacao:inspecionar": "tsx src/sqlite-recovery-inspection-cli.ts",
    "postgres:recuperacao:comparar-filas": "tsx src/postgres-recovery-queues-cli.ts",
    "postinstall": "echo 'Rode: npx playwright install chromium'",
    "ui": "tsx src/server.ts",
    "ui:https": "tsx src/local-https-proxy-cli.ts",
    "test:https-local": "npm run build && node test/local-https-proxy.integration.mjs",
    "test:postgres-https": "npm run build && node test/postgres-https.integration.mjs",
    "postgres:ia:consumir": "tsx src/postgres-ia-worker-cli.ts",
    "dev": "tsx watch src/server.ts",
    "build:frontend": "vite build --config vite.config.ts",
    "build": "npm run build:frontend && node scripts/build-operacional.mjs",
    "start": "node dist/server.js",
    "db:up": "docker compose --env-file .env.docker up -d postgres",
    "db:down": "docker compose --env-file .env.docker stop postgres",
    "db:logs": "docker compose --env-file .env.docker logs -f postgres",
    "db:migrate": "tsx src/postgres-cli.ts",
    "postgres:auditar-importacao": "tsx src/postgres-import-cli.ts",
    "postgres:validar-rls": "tsx src/postgres-rls-check.ts",
    "postgres:runtime:provision": "tsx src/postgres-runtime-role-cli.ts",
    "postgres:runtime:check": "tsx src/postgres-runtime-check.ts",
    "postgres:auth:bootstrap": "tsx src/postgres-auth-cli.ts",
    "postgres:backup": "tsx src/postgres-backup-cli.ts criar",
    "backup:cifrar": "tsx src/backup-envelope-cli.ts",
    "backup:chaves": "tsx src/backup-key-custody-cli.ts",
    "backup:pacote": "tsx src/backup-package-cli.ts",
    "postgres:backup:inventariar": "tsx src/postgres-backup-inventory-cli.ts",
    "postgres:backup:ensaiar-pacote": "tsx src/postgres-package-recovery-cli.ts",
    "postgres:backup:criar-pacote-isolado": "tsx src/postgres-package-creation-cli.ts",
    "test:postgres-backup-cifrado": "npm run build && node test/postgres-encrypted-backup.integration.mjs",
    "test:postgres-recuperacao-limpa": "npm run build && node test/postgres-clean-recovery.integration.mjs",
    "test:postgres-recuperacao-remapeada": "npm run build && node test/postgres-remapped-recovery.integration.mjs",
    "postgres:backup:validar": "tsx src/postgres-backup-cli.ts validar-restauracao",
    "playwright:install": "playwright install chromium",
    "test:smoke": "node --test test/template-cct.smoke.mjs",
    "test:status": "node --test test/analysis-state.smoke.mjs",
    "test:gmail": "npm run build:historico && node --test test/gmail-wizard.smoke.mjs",
    "test:review": "npm run build:historico && node --test test/revisoes.smoke.mjs",
    "test:clientes": "vitest run test/clientes.test.ts",
    "test:clientes-ui": "npm run build:historico && node test/clientes-ui.e2e.mjs",
    "test:resumo-ui": "node test/resumo-ui.e2e.mjs",
    "test:auth-ui": "npm run build:historico && node test/auth-ui.e2e.mjs",
    "test:monitoramento-ui": "node test/monitoramento-ui.e2e.mjs",
    "test:ia-plataforma-ui": "node test/ia-plataforma-ui.e2e.mjs",
    "test:download-budget": "npm run build && node test/chromium-download-budget.e2e.mjs",
    "build:historico": "tsc -p tsconfig.json --outDir dist-historico",
    "test:documentos-ui": "node test/documentos-ui.e2e.mjs",
    "test:cadastros-ui": "node test/cadastros-ui.e2e.mjs",
    "test:workspace-ui": "node test/workspace-navigation.e2e.mjs",
    "test:cliente-vinculos-ui": "node test/cliente-vinculos-ui.e2e.mjs",
    "test:cliente-cnpj-ui": "node test/cliente-cnpj-ui.e2e.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "html-entities": "^2.6.0",
    "nodemailer": "^10.0.16",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "playwright": "^1.48.0",
    "vue": "^3.5.43",
    "word-extractor": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "better-sqlite3": "^11.5.0",
    "node-cron": "^4.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^2.1.5",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=20"
  }
}
