POSTGRES_DB=mediador
POSTGRES_USER=mediador
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=54329

# Parâmetros para conexão da aplicação executada no Windows host.
# Mantenha PGPASSWORD igual a POSTGRES_PASSWORD.
PGHOST=127.0.0.1
PGPORT=54329
PGDATABASE=mediador
PGUSER=mediador
PGPASSWORD=replace-with-a-long-random-password
PGSSLMODE=disable

# Papel restrito obrigatório para servidor e workers PostgreSQL.
PGAPPUSER=mediador_runtime
PGAPPASSWORD=replace-with-a-separate-random-secret-of-at-least-32-characters

