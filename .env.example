# Banco SQLite e pasta de PDFs
# Se houver data/mte-cct-monitor.db da versão antiga, ele é usado automaticamente.
# Descomente para escolher outro caminho de banco:
# DB_PATH=data/mediador.db
# Pasta para documentos Word/PDF originais
DOWNLOAD_DIR=downloads

# Navegador
HEADLESS=true
# "chrome" usa o Google Chrome instalado (recomendado se o portal rejeitar o Chromium headless)
BROWSER_CHANNEL=
REQUEST_TIMEOUT_MS=45000   # cuidado com zeros a mais (450000 = 7,5 min por tentativa)
FORM_TIMEOUT_MS=15000
MAX_RETRIES=2
MAX_PAGES=10

# Notificações antigas: agora também editáveis na UI e persistidas no SQLite (configurações salvas na UI têm prioridade)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Destinatários dos clientes vêm dos contatos vinculados. MAIL_TO é somente para alertas internos.
# Limite estimado da mensagem (anexos + codificação MIME); ajuste conforme seu provedor.
MAIL_MAX_ATTACHMENT_MB=20

# Extração com LLM (opcional). Qualquer API compatível com OpenAI.
# Também configurável pelo painel (Configurações), que tem prioridade sobre estas variáveis.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Origem confiável para cookies e links de recuperação. Local: http://localhost:3000.
# Se UI_PORT mudar, omita esta variável para derivar a porta. Operação externa exige HTTPS.
# AUTH_PUBLIC_URL=http://localhost:3000
# Proxy IP/CIDR allowlist, comma-separated. Empty keeps the direct socket IP.
# AUTH_TRUSTED_PROXY_CIDRS=

# Recuperação de senha PostgreSQL: SMTP da plataforma, independente dos escritórios.
# Desativado por padrão; habilitar exige host/remetente e TLS válido.
# AUTH_SMTP_ENABLED=0
# AUTH_SMTP_HOST=
# AUTH_SMTP_PORT=587
# AUTH_SMTP_SECURE=0
# AUTH_SMTP_FROM=
# AUTH_SMTP_USER=
# AUTH_SMTP_PASS=

# Chave de 32 bytes Base64 para cifrar SMTP por escritório e notificações do portal.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Guarde fora do banco e não use o valor de exemplo em produção.
# CREDENTIALS_MASTER_KEY=
